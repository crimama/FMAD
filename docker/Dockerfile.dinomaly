FROM nvidia/cuda:11.3.1-cudnn8-runtime-ubuntu20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.8 \
    python3.8-dev \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    git \
    ca-certificates \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    patch \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.8 1 && \
    python -m pip install --upgrade pip

WORKDIR /workspace

RUN mkdir -p /workspace/baselines/dinomaly && \
    git clone https://github.com/guojiajeremy/Dinomaly /workspace/baselines/dinomaly/upstream

COPY baselines/dinomaly/patches /workspace/patches
COPY scripts/collect_dinomaly_results.py /workspace/scripts/collect_dinomaly_results.py
COPY scripts/run_dinomaly.sh /workspace/scripts/run_dinomaly.sh

WORKDIR /workspace/baselines/dinomaly/upstream

RUN python -m pip install \
    torch==1.12.0+cu113 \
    torchvision==0.13.0+cu113 \
    --extra-index-url https://download.pytorch.org/whl/cu113 && \
    grep -vE '^(torch|torchvision|--find-links)' requirements.txt > /tmp/dinomaly-requirements.txt && \
    python -m pip install -r /tmp/dinomaly-requirements.txt

RUN chmod +x /workspace/scripts/run_dinomaly.sh

WORKDIR /workspace
